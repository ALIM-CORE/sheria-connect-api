# Copy these deployment settings into the EXISTING VPS .env, preserving secrets.
# Never copy local development credentials into production.
COMPOSE_PROJECT_NAME=sheria-connect
DB_VOLUME_NAME=REPLACE_WITH_INSPECTED_EXISTING_VOLUME
CLOUDBEAVER_VOLUME_NAME=REPLACE_WITH_INSPECTED_EXISTING_VOLUME
CLOUDBEAVER_IMAGE=REPLACE_WITH_EXISTING_IMAGE_DIGEST
EVIDENCE_HOST_PATH=/srv/apps/sheria-connect/uploads/evidence
EVIDENCE_STORAGE_ROOT=/app/uploads/evidence

SPRING_PROFILES_ACTIVE=prod
APP_ENV=prod
APP_NAME=sheria-connect-api
APP_URL=https://api.sheriaconnect.co.tz
DB_HOST=db
DB_PORT=5432
DB_NAME=RETAIN_EXISTING_VALUE
DB_USERNAME=RETAIN_EXISTING_VALUE
DB_PASSWORD=RETAIN_EXISTING_VALUE
JWT_SECRET=RETAIN_EXISTING_VALUE
# Keep MFA_ENCRYPTION_KEY unchanged: rotating it makes existing TOTP unreadable.
# If it previously fell back to JWT_SECRET, explicitly use that same value.
MFA_ENCRYPTION_KEY=RETAIN_EXISTING_EFFECTIVE_VALUE
TRACKING_TOKEN_DERIVATION_KEY=RETAIN_EXISTING_EFFECTIVE_VALUE

WEB_BASE_URL=https://api.sheriaconnect.co.tz
WEB_BASE_DOMAIN=https://sheriaconnect.co.tz
# The portal currently implements these public auth routes; the Citizen site does not yet.
AUTH_WEB_BASE_URL=https://admin.sheriaconnect.co.tz
ADMIN_BASE_URL=https://admin.sheriaconnect.co.tz
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_COOKIE_PATH=/
CORS_ALLOWED_ORIGINS=https://sheriaconnect.co.tz,https://www.sheriaconnect.co.tz,https://admin.sheriaconnect.co.tz,https://app.sheriaconnect.co.tz
MOBILE_BASE_URL=sheria://app

# Preserve existing SMTP settings. Do not commit their real values.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=RETAIN_EXISTING_VALUE
MAIL_PASSWORD=RETAIN_EXISTING_VALUE
MAIL_FROM_NAME=Sheria Connect
MAIL_FROM_ADDRESS=RETAIN_EXISTING_VALUE
# Existing staff have already been provisioned. Blank bootstrap credentials avoid
# resetting their passwords on every backend deployment.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=
